# Primary gateway (self-hosted open Hermes)
OBLITERATUS_GATEWAY_URL=https://obliteratus.kissikingdom.com
OBLITERATUS_API_KEY=your-key
OBLITERATUS_MODEL=obliteratus-hermes-3-70b
# Open-source chat fallback (any one; all free tiers)
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# Local Ollama (dev only)
OLLAMA_URL=
OLLAMA_MODEL=hermes3
# Deep-research open model stacks (comma-separated, optional overrides)
GROQ_MODELS=llama-3.3-70b-versatile,deepseek-r1-distill-llama-70b,qwen-2.5-32b
OPENROUTER_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free,qwen/qwen-2.5-72b-instruct:free
HF_MODELS=meta-llama/Llama-3.3-70B-Instruct
