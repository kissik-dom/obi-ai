# Copy to .env and fill. NEVER commit .env. Rotate any key ever exposed.
POSTGRES_USER=kingdom
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kingdom
VALKEY_URL=redis://valkey:6379/0
QDRANT_URL=http://qdrant:6333
# Model gateway / cloud fallback (optional, keep out of git)
LITELLM_MASTER_KEY=
OPENROUTER_API_KEY=

# Task service (services/api)
TASK_STORE_PATH=/app/data/tasks.json
# One bearer token per workspace. No token may list tasks from another workspace.
TASK_API_KEYS=research:change-me-research-token,images:change-me-images-token
