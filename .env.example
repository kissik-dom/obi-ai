# 1. OpenRouter 10-Key Auto-Failover Pool (LiteLLM Router: num_retries=3, timeout=60)
OPENROUTER_API_KEY_1=sk-or-v1-replace-key-1
OPENROUTER_API_KEY_2=sk-or-v1-replace-key-2
OPENROUTER_API_KEY_3=sk-or-v1-replace-key-3
OPENROUTER_API_KEY_4=sk-or-v1-replace-key-4
OPENROUTER_API_KEY_5=sk-or-v1-replace-key-5
OPENROUTER_API_KEY_6=sk-or-v1-replace-key-6
OPENROUTER_API_KEY_7=sk-or-v1-replace-key-7
OPENROUTER_API_KEY_8=sk-or-v1-replace-key-8
OPENROUTER_API_KEY_9=sk-or-v1-replace-key-9
OPENROUTER_API_KEY_10=sk-or-v1-replace-key-10
OPENROUTER_API_KEY=sk-or-v1-replace-primary-key
LITELLM_MASTER_KEY=sk-kingdom-litellm-master
LITELLM_PROXY_URL=http://litellm:4000

# 2. Obliteratus Hermes Gateway (Optional Self-Hosted Primary Cascade)
OBLITERATUS_GATEWAY_URL=https://obliteratus.kissikingdom.com
OBLITERATUS_API_KEY=replace-obliteratus-key
OBLITERATUS_MODEL=obliteratus-hermes-3-70b
HF_TOKEN=hf_replace_optional_token

# 3. Vector, Object, Secret, Relational & Queue Stores
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kingdom_knowledge_768d

MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_URL=http://minio:9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_SECURE=false
MINIO_FINISHED_BUCKET=kingdom-finished
MINIO_REQUESTS_BUCKET=kingdom-requests

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=root
VAULT_TRANSIT_KEY=kingdom-hsm-financial

POSTGRES_DB=kingdom
POSTGRES_USER=kingdom
POSTGRES_PASSWORD=kingdom123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kingdom:kingdom123@postgres:5432/kingdom

REDIS_URL=redis://redis:6379/0

# 4. Vultr GPU & GitHub Deployment Automation
GITHUB_REPO=YOURNAME/kingdom-ai-os
GITHUB_TOKEN=github_pat_replace_token
VULTR_API_KEY=replace_vultr_api_key_from_my_vultr_com_settings_api
VULTR_REGION=ewr
VULTR_PLAN=vcg-a100-1c-8g-40vram
VULTR_OS_ID=1743

# 5. Security, API Auth, Self-Allowlist & Bank-Grade Continuous Testing
KINGDOM_API_KEY=
KINGDOM_INTERNAL_SECRET=a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4
CROWDSEC_LAPI_URL=http://crowdsec:8080
WAZUH_MANAGER_URL=https://wazuh:55000
COMPREFACE_URL=http://compreface:8001
TEST_INTERVAL=1200

# 6. Listmonk Bounce-Retry & Legal Timestamp Mailer
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASS=kingdom123
LISTMONK_BOUNCE_RETRY=always
LISTMONK_BOUNCE_RETRY_COUNT=10
LISTMONK_LEGAL_TIMESTAMP=true

# 7. Granular Feature Turn-Off Flags (Default: true; set false to disable cleanly)
ENABLE_SANDBOX_EQUIP_ALL=true
ENABLE_DISCOVERY=true
ENABLE_SANDBOX=true
ENABLE_SECURITY=true
ENABLE_HERMES=true
ENABLE_LLM_ROUTER=true
ENABLE_IMAGE_CONSISTENCY=true
ENABLE_VIDEO_AGENT=true
ENABLE_ENGINEERING=true
ENABLE_VOCAL_TUNING=true
ENABLE_TESTING=true
ENABLE_SELF_UPDATE=true
ENABLE_TAB_BUILDER=true
ENABLE_NEVER_GIVE_UP=true

# 8. Optional Convex External Sync Webhook
CONVEX_WEBHOOK_URL=
