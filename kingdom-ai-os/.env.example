# Copy to .env and replace all placeholders. Never commit .env.
APP_ENV=development
APP_NAME=Kingdom AI OS API
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=5173
POSTGRES_DB=kingdom_ai
POSTGRES_USER=kingdom_app
POSTGRES_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
QDRANT_API_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
MINIO_ROOT_USER=REPLACE_WITH_NONDEFAULT_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
LITELLM_MASTER_KEY=REPLACE_WITH_UNIQUE_RANDOM_SECRET
KINGDOM_INTERNAL_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET
FIREWORKS_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
# Do not put provider keys in frontend/.env or VITE_* variables.
